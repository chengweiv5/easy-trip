  "cards": [
    {
      "dot": "cyan",
      "title": "原生 Runtime，不模拟点击",
      "items": [
        "Kotlin + Coroutines/Flow；Room 保存恢复点。",
        "手机内执行工具；模型只提议，触屏功能独立可用。"
      ]
    },
    {
      "dot": "violet",
      "title": "默认直连，网关非必需",
      "items": [
        "填写 provider / endpoint / key / model 即可。",
        "个人 key 由 Keystore 支持的加密存储保护，不内置 APK。"
      ]
    },
    {
      "dot": "rose",
      "title": "确认、事务与唯一事实",
      "items": [
        "地点、分类、来源、回执在同一 Room 事务提交。",
        "紫虚线：持久化或可选路由；红虚线：本地确认门控。"
      ]
    },
    {
      "dot": "amber",
      "title": "DeepSeek 协议边界",
      "items": [
        "图片直传，OCR 可选；初始显式关闭 thinking。",
        "文档支持不等于账号实测；开启 thinking 须保留续接字段。"
      ]
    }
